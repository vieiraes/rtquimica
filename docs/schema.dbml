Project RTQuimico {
  database_type: 'PostgreSQL'
  Note: 'Schema for RTQuimico SaaS Platform with Multi-tenancy and RBAC'
}

Enum app_role {
  superadmin [note: 'System owner, manages all tenants and subscriptions']
  tenant_admin [note: 'Owner/Manager of a specific tenant workspace']
  tenant_member [note: 'Standard professional working within a tenant workspace']
  tenant_client [note: 'External company/client viewing their specific RTs']
}

Enum plan_type {
  basic
  pro
  enterprise
}

Enum rt_status {
  active
  pending
  expired
  canceled
}

Enum document_type {
  TRT
  ART
  CRT
  other
}

Table tenants {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  plan plan_type [not null, default: 'basic']
  created_at timestamptz [not null, default: `now()`]
  
  Note: 'Represents a Workspace/Account for a client (chemical consultant or company)'
}

Table profiles {
  id uuid [pk, note: 'References auth.users(id)']
  tenant_id uuid [ref: > tenants.id, note: 'Links user to their workspace']
  role app_role [not null, default: 'tenant_member']
  email text [not null]
  name text [not null]
  crq_number text
  crq_state text
  phone text
  avatar_url text
  created_at timestamptz [not null, default: `now()`]
}

Table technical_responsibilities {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  user_id uuid [ref: > profiles.id, note: 'Which professional is the technical responsible']
  company_name text [not null]
  company_cnpj text [not null]
  document_type document_type [not null]
  document_number text
  start_date date [not null]
  end_date date [not null]
  status rt_status [not null, default: 'pending']
  crq_region text [not null]
  notes text
  created_at timestamptz [not null, default: `now()`]
}

Table documents {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  rt_id uuid [not null, ref: > technical_responsibilities.id]
  name text [not null]
  type document_type [not null, default: 'other']
  file_url text [not null]
  uploaded_at timestamptz [not null, default: `now()`]
}

Table alerts {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  rt_id uuid [ref: > technical_responsibilities.id]
  type text [not null]
  title text [not null]
  message text [not null]
  is_read boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
}

Table technical_actions {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  rt_id uuid [not null, ref: > technical_responsibilities.id]
  category text [not null]
  description text [not null]
  action_date timestamptz [not null, default: `now()`]
  attachments jsonb [not null, default: '[]']
  created_at timestamptz [not null, default: `now()`]
}

Table checklists {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, ref: > tenants.id]
  rt_id uuid [not null, ref: > technical_responsibilities.id]
  status text [not null]
  items jsonb [not null, default: '[]']
  progress integer [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]
}

Table sop_templates {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [ref: > tenants.id, note: 'If null, it is a global template provided by superadmin']
  title text [not null]
  segment text [not null]
  content text [not null]
  created_at timestamptz [not null, default: `now()`]
}
